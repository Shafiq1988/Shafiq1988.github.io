{
  "output": {
    "dpi": 600,
    "width_inches": 3.5,
    "height_inches": 2.75
  },
  "fonts": {
    "family": "Arial",
    "fallbacks": ["Helvetica", "DejaVu Sans", "sans-serif"],
    "base_size": 7.5,
    "axis_label_size": 8.5,
    "title_size": 9.5,
    "tick_size": 7.5,
    "legend_size": 7.2,
    "value_size": 6.4,
    "annotation_size": 6.8
  },
  "colors": {
    "dark": "#4D4D4D",
    "illuminated": "#0F4D92",
    "annotation": "#B85C38",
    "zero_line": "#D9D9D9",
    "background": "#FFFFFF"
  },
  "lines": {
    "oer_level_width": 2.0,
    "oer_connector_width": 1.25,
    "her_line_width": 1.8,
    "axis_width": 0.8,
    "zero_line_width": 0.6,
    "arrow_width": 0.8
  },
  "markers": {
    "size": 4.0,
    "dark": "o",
    "illuminated": "s"
  },
  "axes": {
    "oer_ymin": -3.55,
    "oer_ymax": 5.2,
    "her_ymin": -0.08,
    "her_ymax": 1.3
  },
  "legend": {
    "show": true,
    "location": "upper left",
    "frame": false
  },
  "labels": {
    "show_energy_values": true,
    "show_annotations": true,
    "show_descriptor": true
  },
  "axis": {
    "oer_y_title": "Cumulative $\\Delta G$ (eV)",
    "her_y_title": "Relative $\\Delta G$ (eV)",
    "x_title": "",
    "show_title": true,
    "show_x_title": false,
    "show_y_title": true,
    "show_x_tick_labels": true,
    "show_y_tick_labels": true,
    "tick_label_rotation": 0,
    "tick_direction": "out",
    "major_tick_length": 3.5,
    "minor_tick_length": 2.0,
    "minor_tick_count": 0,
    "oer_major_step": 1.0,
    "her_major_step": 0.25,
    "x_min": null,
    "x_max": null,
    "x_reverse": false,
    "y_reverse": false,
    "x_scale": "linear",
    "y_scale": "linear"
  },
  "frame": {
    "left": true,
    "bottom": true,
    "right": false,
    "top": false,
    "color": "#000000",
    "width": 0.8
  },
  "grid": {
    "x_major": false,
    "y_major": false,
    "x_minor": false,
    "y_minor": false,
    "color": "#E6E6E6",
    "width": 0.5,
    "style": "--"
  },
  "reference_lines": {
    "x_values": [],
    "y_values": [],
    "color": "#999999",
    "width": 0.7,
    "style": "--"
  },
  "layout": {
    "auto_tight": true,
    "left": 0.14,
    "right": 0.97,
    "bottom": 0.16,
    "top": 0.90,
    "wspace": 0.35,
    "hspace": 0.38
  }
}
